{
  "name": "create-tinyss",
  "version": "0.0.1",
  "description": "A Tiny static site generator",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "tinyss": "bin/cli.mjs"
  },
  "scripts": {
    "test": "npm run test:biome && npm run test:unit",
    "prepare": "npm run build",
    "test:biome": "biome check src",
    "test:unit": "node --experimental-transform-types --no-warnings --test 'src/**/*.test.ts'",
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node22 --outfile=bin/cli.mjs --format=esm --packages=external --jsx=automatic --jsx-import-source=preact --banner:js='#!/usr/bin/env node' && chmod +x bin/cli.mjs",
    "build:demo": "./bin/cli.mjs demo/*",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "fix": "biome check --apply src",
    "dev": "node --experimental-transform-types --no-warnings src/cli.ts serve demo/* --port 3000",
    "generate:schema": "node --experimental-transform-types --no-warnings src/generate-schema.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "esbuild": "^0.27.4",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-frontmatter": "^2.0.1",
    "micromark": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "mime": "^4.0.3",
    "preact": "^10.29.0",
    "preact-render-to-string": "^6.6.6",
    "toml": "^3.0.0",
    "yaml": "^2.4.2",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@playwright/test": "^1.58.2"
  }
}
