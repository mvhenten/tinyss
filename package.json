{
  "name": "diagrams",
  "version": "1.0.0",
  "description": "Store diagrams",
  "main": "index.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "test": "npm run test:biome && npm run test:unit",
    "test:biome": "biome check src",
    "test:unit": "node --test **/*.test.mjs",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "npm-run-all --parallel start watch",
    "start": "serve -s build",
    "fix": "biome check --apply src"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "handlebars": "^4.7.8",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-frontmatter": "^2.0.1",
    "micromark": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "mime": "^4.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "rollup": "^4.18.0",
    "serve": "^14.2.3",
    "toml": "^3.0.0",
    "yaml": "^2.4.2"
  }
}
