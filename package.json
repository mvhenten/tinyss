{
  "name": "create-tinyss",
  "version": "0.0.1",
  "description": "A Tiny static site generator",
  "main": "src/index.mjs",
  "bin": {
    "tinyss": "bin/cli.mjs"
  },
  "scripts": {
    "test": "npm run test:biome && npm run test:unit",
    "prepare": "npm run build",
    "test:biome": "biome check src",
    "test:unit": "node --test **/*.test.mjs",
    "build": "rollup -c && chmod +x bin/cli.mjs",
    "build:demo": "./bin/cli.mjs demo/*",
    "watch": "rollup -c -w",
    "dev": "npm-run-all --parallel start watch",
    "start": "serve -s build",
    "fix": "biome check --apply src"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "1.7.3",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "handlebars": "^4.7.8",
    "mdast-util-from-markdown": "^2.0.0",
    "mdast-util-frontmatter": "^2.0.1",
    "micromark": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "mime": "^4.0.3",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.2.5",
    "rollup": "^4.18.0",
    "rollup-plugin-preserve-shebang": "^1.0.1",
    "serve": "^14.2.3",
    "toml": "^3.0.0",
    "watchy": "^0.10.1",
    "yaml": "^2.4.2"
  }
}
